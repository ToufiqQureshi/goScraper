  "cards": [
    {
      "dot": "cyan",
      "title": "One request",
      "items": [
        "Get picks a slot round-robin, then reuses a tab that is already open",
        "The tab goes back to its pool as soon as your callback returns"
      ]
    },
    {
      "dot": "emerald",
      "title": "Reuse and recovery",
      "items": [
        "Both pools share one core: a free Alive check every Get, the round-trip check outside a 2s window",
        "A crashed tab is replaced; a crashed Chrome is rebuilt with its tab pool and the request retried once"
      ]
    },
    {
      "dot": "rose",
      "title": "Limits and trust",
      "items": [
        "Browsers x PagesPerBrowser caps concurrency; Get blocks instead of spawning more",
        "Untrusted pages render in Chrome, a separate process, with its sandbox on by default"
      ]
    }
  ]
